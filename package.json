{
  "name": "article-agent",
  "version": "0.1.0",
  "private": true,
  "description": "从 PDF 研究文章中按层级提取信息的多 Agent 流水线",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core/tsconfig.json && tsc -p packages/ingest/tsconfig.json && tsc -p packages/crossref/tsconfig.json && tsc -p packages/skills/tsconfig.json && tsc -p apps/web/tsconfig.json",
    "build": "pnpm -r build",
    "check": "pnpm typecheck && pnpm test",
    "gold:normalize": "node tools/gold_normalize.mjs",
    "gold:rebuild": "node tools/gold_normalize.mjs --apply-reconcile && node tools/gold_fix_units.mjs --apply",
    "gold:reconcile": "node tools/gold_reconcile.mjs",
    "mineru:batch": "node tools/mineru_batch.mjs",
    "mineru:clean": "node tools/mineru_clean.mjs",
    "pipeline": "pnpm mineru:batch && pnpm mineru:clean",
    "prompts": "node tools/prompt_gen.mjs",
    "legend": "node tools/legend_extract.mjs",
    "legend:audit": "node tools/legend_audit.mjs",
    "web:api": "node apps/web/server.mjs",
    "web:dev": "pnpm --filter @aa/web exec vite",
    "web:build": "pnpm --filter @aa/web exec vite build",
    "web:smoke": "node tools/web_smoke.mjs",
    "llm:run": "pnpm -r build && node tools/llm_run.mjs",
    "llm:eval": "node tools/llm_eval.mjs",
    "accuracy:overview": "node tools/accuracy_overview.mjs",
    "accuracy:diagnose": "node tools/accuracy_diagnose.mjs",
    "fields:coverage": "node tools/field_coverage.mjs",
    "gold:anomalies": "node tools/gold_anomalies.mjs",
    "judge:report": "node tools/judge_report.mjs",
    "gold:vs-paper": "node tools/gold_vs_paper.mjs",
    "gold:evidence": "node tools/gold_evidence_check.mjs",
    "diagnose:low": "node tools/diagnose_low.mjs",
    "judge:cmp-desc": "node tools/desc_field_judge.mjs",
    "judge:article-desc": "node tools/desc_field_judge.mjs --scope article",
    "metadata:fields": "node tools/metadata_accuracy.mjs",
    "metadata:ceiling": "node tools/metadata_ceiling.mjs",
    "if:index": "node tools/if_index.mjs",
    "if:gaps": "node tools/if_index.mjs --gaps",
    "if:gold": "node tools/if_gold_anomalies.mjs",
    "gold:timepoints": "node tools/gold_timepoint_anomalies.mjs",
    "parse:health": "node tools/parse_health.mjs",
    "sheet3:sources": "node tools/sheet3_sources.mjs",
    "mineru:media": "node tools/mineru_media_audit.mjs",
    "sheet3:numeric": "node tools/_sheet3_numeric.mjs",
    "sheet3:miss": "node tools/_sheet3_miss_kinds.mjs",
    "reapply:consistency": "node tools/reapply_consistency.mjs",
    "gold:rows": "node tools/gold_row_anomalies.mjs",
    "web:e2e": "playwright test",
    "desktop:dev": "electron apps/desktop",
    "desktop:build": "node tools/desktop_make.mjs",
    "desktop:build:raw": "node tools/make_icon.mjs build/icon.png && cd apps/desktop && electron-builder --win portable --config electron-builder.yml",
    "desktop:exe": "node tools/desktop_make.mjs",
    "desktop:verify": "node tools/desktop_verify.mjs",
    "desktop:stage": "node tools/desktop_stage_modules.mjs",
    "icon": "node tools/make_icon.mjs build/icon.png",
    "deck": "node tools/make_deck.mjs && node tools/deck_preview.mjs",
    "deck:check": "node tools/deck_layout_check.mjs",
    "run:all": "node tools/run_all_years.mjs --follow --jobs 8",
    "report:clinicians": "node tools/report_clinicians.mjs",
    "gold:columns": "node tools/gold_column_map.mjs",
    "outcomes:dictionary": "node tools/outcome_dictionary.mjs",
    "outcomes:coverage": "node tools/outcome_coverage.mjs",
    "issues:taxonomy": "node tools/problem_taxonomy.mjs",
    "overfill": "node tools/overfill_breakdown.mjs",
    "sheet1:fields": "node tools/sheet1_fields.mjs",
    "materials:coverage": "node tools/materials_coverage.mjs",
    "materials:gap": "node tools/materials_gap.mjs",
    "short:values": "node tools/short_value_locations.mjs",
    "latex:noise": "node tools/latex_noise.mjs",
    "latex:shapes": "node tools/latex_shapes.mjs",
    "latex:impact": "node tools/latex_value_impact.mjs",
    "fidelity": "node tools/table_fidelity.mjs",
    "fidelity:raw": "node tools/table_fidelity.mjs --raw",
    "ab:fields": "node tools/latex_ab_fields.mjs",
    "ab:eval": "node tools/eval_compare.mjs",
    "epmc:probe": "node tools/_europepmc_probe.mjs",
    "epmc:sizing": "node tools/_europepmc_sizing.mjs",
    "epmc:effect": "node tools/_europepmc_effect.mjs",
    "epmc:meta": "node tools/_europepmc_meta.mjs",
    "epmc:vs-crossref": "node tools/_epmc_vs_crossref_title.mjs",
    "epmc:forecast": "node tools/_epmc_title_forecast.mjs",
    "ab:field": "node tools/field_ab_check.mjs",
    "units:audit": "node tools/_scheme_columns_direct.mjs",
    "units:legend": "node tools/_unit_legend_anomaly.mjs",
    "units:coverage": "node tools/_unit_judge_coverage.mjs",
    "units:ab": "node tools/_unit_rules_ab.mjs",
    "gold:units": "node tools/gold_fix_units.mjs",
    "gold:units:apply": "node tools/gold_fix_units.mjs --apply",
    "gold:units:verify": "node tools/gold_fix_units_verify.mjs",
    "gold:units:recon": "node tools/gold_fix_units_recon.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
